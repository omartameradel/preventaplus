rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 20 * 1024 * 1024;
    }
    match /library/{adminId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/(default)/documents/admins/$(request.auth.uid)) && get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active != false && request.resource.size < 200 * 1024 * 1024;
    }
  }
}