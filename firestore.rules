rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'tamer.adel.1981@gmail.com';
    }
    function isPrimaryAdmin() {
      return isAdmin() && request.auth.token.email == 'tamer.adel.1981@gmail.com';
    }
    function validUserPresence(presenceId) {
      return signedIn() &&
        request.auth.uid == presenceId &&
        request.resource.data.keys().hasAll([
          'name', 'email', 'role', 'deviceType', 'os', 'browser',
          'location', 'ip', 'currentPage', 'online', 'lastSeenAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'id', 'userId', 'email', 'name', 'role', 'page', 'currentPage',
          'lastAction', 'deviceType', 'os', 'browser', 'location', 'ip',
          'online', 'lastSeenAt', 'sessionStartAt', 'openedAt'
        ]) &&
        (
          (request.resource.data.keys().hasAny(['id']) && request.resource.data.id == presenceId) ||
          (request.resource.data.keys().hasAny(['userId']) && request.resource.data.userId == presenceId)
        ) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.role is string &&
        request.resource.data.deviceType is string &&
        request.resource.data.os is string &&
        request.resource.data.browser is string &&
        request.resource.data.location is string &&
        request.resource.data.ip is string &&
        request.resource.data.currentPage is string &&
        request.resource.data.online is bool &&
        request.resource.data.lastSeenAt is timestamp &&
        (request.resource.data.role != 'admin' || isAdmin());
    }
    function validGuestPresence(presenceId) {
      return presenceId.matches('^guest_[A-Za-z0-9_-]{20,64}$') &&
        request.resource.data.keys().hasAll([
          'id', 'visitor', 'name', 'email', 'role', 'deviceType', 'os',
          'browser', 'ip', 'location', 'currentPage', 'lastSeenAt',
          'sessionStartAt', 'online'
        ]) &&
        request.resource.data.keys().hasOnly([
          'id', 'visitor', 'name', 'email', 'role', 'deviceType', 'os',
          'browser', 'ip', 'location', 'currentPage', 'lastSeenAt',
          'sessionStartAt', 'online'
        ]) &&
        request.resource.data.id == presenceId &&
        request.resource.data.visitor == true &&
        request.resource.data.role == 'guest' &&
        request.resource.data.email == '' &&
        request.resource.data.deviceType is string &&
        request.resource.data.os is string &&
        request.resource.data.browser is string &&
        request.resource.data.ip is string &&
        request.resource.data.location is string &&
        request.resource.data.currentPage is string &&
        request.resource.data.name is string &&
        request.resource.data.online is bool &&
        request.resource.data.lastSeenAt is timestamp &&
        request.resource.data.sessionStartAt is timestamp &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.deviceType.size() <= 30 &&
        request.resource.data.os.size() <= 40 &&
        request.resource.data.browser.size() <= 50 &&
        request.resource.data.ip.size() <= 50 &&
        request.resource.data.location.size() <= 120 &&
        request.resource.data.currentPage.size() <= 200;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /news/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.isActive == false &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'phone', 'jobTitle', 'governorate',
          'workAdministration', 'status', 'isActive', 'allowedPages', 'createdAt'
        ])
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoData', 'governorate', 'job', 'jobTitle', 'workplace', 'workAdministration', 'address']));
    }
    match /dashboardPresence/{presenceId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == presenceId);
      allow create, update: if isAdmin() || validUserPresence(presenceId) || validGuestPresence(presenceId);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == presenceId);
    }
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }
    match /meetings/{meetingId} {
      allow read: if signedIn();
      allow create: if isPrimaryAdmin() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isPrimaryAdmin() && request.resource.data.hostUid == request.auth.uid && (resource.data.hostUid == request.auth.uid || !resource.data.keys().hasAny(['hostUid']));
      allow delete: if isPrimaryAdmin() && (resource.data.hostUid == request.auth.uid || !resource.data.keys().hasAny(['hostUid']));
    }
    match /tests/{testId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /testAttempts/{attemptId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }
    match /meetingAttendance/{attendanceId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /pages/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /libraryPages/{pageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /ministerialPublications/{pageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /formsPages/{pageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /preventionDesignsPages/{pageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
