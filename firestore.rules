rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /news/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoData', 'governorate', 'password', 'job', 'address']));
    }
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }
    match /meetings/{meetingId} {
      allow read, write: if signedIn();
    }
    match /tests/{testId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /pages/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /libraryPages/{pageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
